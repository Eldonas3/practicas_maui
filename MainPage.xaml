<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PruebaMaui.MainPage">

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">  

            <Label
                Text="Procesador de datos!!!"
                FontSize="24"
                HorizontalOptions="Center"    
                />
            
            <Label
                x:Name="lblEstado"
                Text="Esperando..."
                HorizontalOptions="Center"
                />

            <ProgressBar
                x:Name="barraProgreso"
                Progress="0"
                />
            
            <Button
                x:Name="btnIniciar"
                Text="Iniciar Procesamiento"
                Clicked="OnIniciarClicked"
                />
            
            <Button
                x:Name="btnCancelar"
                Text="Cancelar Procesamiento"
                Clicked="OnCancelarClicked"
                />
        </VerticalStackLayout>

</ContentPage>
